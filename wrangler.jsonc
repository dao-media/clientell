{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "briefly",
	"compatibility_date": "2026-06-19",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"vars": {
		"PUBLIC_ORIGIN": "https://briefly.daneoleary.com",
		"EMAIL_FROM": "briefly@daneoleary.com",
		"CLOUDFLARE_ACCOUNT_ID": "f10ff17695a7e81951dc05a2a149c1db"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "briefly-db",
			"database_id": "c90cd421-1507-4604-b4dc-82d7448b75bc",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "briefly"
		}
	]
}
